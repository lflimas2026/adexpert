# ============================================
# AdExpert - Configuração de APIs
# ============================================
# Copie este arquivo para .env e preencha as chaves:
# cp .env.example .env

# === GEMINI (Google AI) ===
# Obtenha sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# === META ADS (Facebook/Instagram) ===
# Obtenha em: https://developers.facebook.com/apps
# Token de acesso de longa duração com permissões: ads_read, ads_management
META_ADS_ACCESS_TOKEN=EAAc58vndEZA0BRumBZA9kcCQZBftESAz72oxEhpIC9fStoY4cVQiUdzPwKuzCLgMOm3ipYrfKjahbReHI90DUZA72wM79acYm0FotyoHZBTxj6cHNSiJFYcJZBVFpX5ML909SZCygkxrx2MvPdGixyVc2S4eSLbNLW1UTwTxIyGY1NWJVRKrynGz2ZCzbZAyEqs8EKSbf
META_ADS_ACCOUNT_ID=2034040573858205

# === GOOGLE ADS ===
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Developer token: https://developers.google.com/google-ads/api/docs/first-call/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=seu_dev_token_aqui
GOOGLE_ADS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID= (opcional)

# === TIKTOK ADS ===
# Obtenha em: https://ads.tiktok.com/marketing_api/apps
TIKTOK_ADS_ACCESS_TOKEN=seu_token_aqui
TIKTOK_ADS_ADVERTISER_ID=seu_advertiser_id
TIKTOK_ADS_APP_ID=seu_app_id
TIKTOK_ADS_SECRET=seu_secret
